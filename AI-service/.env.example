DATABASE_URL="postgresql://postgres:postgres@localhost:5434/distrosync_ai?schema=public"
CONVERSATION_HISTORY_LIMIT=20

GROQ_API_KEY=[REDACTED]
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=512

QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=[REDACTED]
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
TOP_K=5

# Entity resolution policy
SEMANTIC_SEARCH_HIGH_THRESHOLD=0.85
SEMANTIC_SEARCH_MEDIUM_THRESHOLD=0.55
SEMANTIC_SEARCH_MIN_SCORE=0.45
SEMANTIC_SEARCH_AMBIGUITY_GAP=0.05
# Optional dense model augmentation; local fuzzy/vector fallback is always available.
SEMANTIC_SEARCH_ENABLE_EMBEDDINGS=false

# Internal ERP service
ERP_SERVICE_URL=http://localhost:4002
ERP_SERVICE_API_KEY=[REDACTED]
ERP_TIMEOUT_SECONDS=15
