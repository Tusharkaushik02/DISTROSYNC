# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/distrosync_erp?schema=public"

# ─── Server ─────────────────────────────────────────────────────────
PORT=4002
NODE_ENV=development
SERVICE_NAME=ERP-Service

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT (must match User Service secret for token verification) ────
JWT_ACCESS_SECRET="your_jwt_access_secret_here"

# ─── Service-to-Service Auth ───────────────────────────────────────
SERVICE_API_KEY="your_strong_random_service_api_key_here"

# ─── AI Service Connection ─────────────────────────────────────────
AI_SERVICE_URL="http://localhost:8000"
AI_SERVICE_API_KEY="your_ai_service_api_key_here"

# ─── File Storage ──────────────────────────────────────────────────
UPLOAD_DIR="./storage/documents"
MAX_FILE_SIZE_MB=10
