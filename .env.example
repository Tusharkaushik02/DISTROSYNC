# ==============================================================================
# DISTROSYNC UNIFIED ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# --- Global / Shared Settings ---
NODE_ENV=development
SHARED_SERVICE_API_KEY=65c47afdd3eff0ebc554035a37dcf700e12c8fd7b634962ebf24126a5c5f08b5
DEFAULT_TENANT_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11

# --- PostgreSQL Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- WhatsApp Service (:4001) ---
WHATSAPP_PORT=4001
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=https://your-ngrok-domain.ngrok-free.dev/api/v2/whatsapp/webhook
AI_SERVICE_TIMEOUT_MS=30000

# --- AI Service (:8000) ---
AI_PORT=8000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
CONVERSATION_HISTORY_LIMIT=20
QDRANT_PATH=./data/qdrant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- ERP Service (:4002) ---
ERP_PORT=4002
UPLOAD_DIR=./storage/documents
MAX_FILE_SIZE_MB=10

# --- User Service (:3000) ---
USER_PORT=3000
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
