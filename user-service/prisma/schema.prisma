// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum WhatsAppStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ERPStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
}

enum ERPType {
  TALLY
  BUSY
  MARG
  SAP
  ORACLE
  CUSTOM
}

model User {
  id              String      @id @default(uuid()) @db.Uuid

  companyId       String?     @unique @db.Uuid
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name            String
  email           String      @unique
  phone           String?

  passwordHash    String

  role            UserRole    @default(ADMIN)
  status          UserStatus  @default(ACTIVE)

  emailVerified   Boolean     @default(false)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([email])
  @@index([companyId])
  @@index([status])
}

model Company {
  id                 String    @id @default(uuid()) @db.Uuid

  companyName        String

  address            String?

  contactEmail       String?

  contactPhone       String?

  createdAt          DateTime  @default(now())

  updatedAt          DateTime  @updatedAt

  users              User[]

  whatsappConfig     WhatsAppConfiguration?

  erpConfig          ERPConfiguration?
}

model WhatsAppConfiguration {
  id                   String             @id @default(uuid()) @db.Uuid

  companyId            String             @unique @db.Uuid

  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  businessAccountId    String

  phoneNumberId        String

  accessToken          String

  webhookVerifyToken   String

  webhookSecret        String

  status               WhatsAppStatus     @default(PENDING)

  connectedAt          DateTime?

  lastSyncedAt         DateTime?

  createdAt            DateTime           @default(now())

  updatedAt            DateTime           @updatedAt

  @@index([status])
}

model ERPConfiguration {

  id                   String      @id @default(uuid()) @db.Uuid

  companyId            String      @unique @db.Uuid

  company              Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  erpType              ERPType

  pluginName           String

  connectionConfig     Json

  status               ERPStatus   @default(PENDING)

  connectedAt          DateTime?

  lastSyncedAt         DateTime?

  createdAt            DateTime    @default(now())

  updatedAt            DateTime    @updatedAt

  @@index([erpType])

  @@index([status])
}